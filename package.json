  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.24",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tsx": "4.23.15",
    "typescript": "^5.9.3"
  }
