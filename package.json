{
  "name": "stuckatstack",
  "version": "1.0.0",
  "description": "Intelligent tech stack recommendation tool for founders and developers",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/*.test.mjs",
    "test:production": "TEST_SERVER_MODE=production node --test tests/*.test.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "db:init": "tsx src/lib/db/init.ts"
  },
  "keywords": [
    "tech-stack",
    "recommendation",
    "startup"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
